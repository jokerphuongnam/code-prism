{
  "name": "swift-prism",
  "displayName": "SwiftPrism",
  "description": "Function-level dependency extraction and 3D visualization for Swift codebases",
  "version": "0.1.0",
  "publisher": "swift-prism",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swiftPrismContainer",
          "title": "SwiftPrism",
          "icon": "resources/prism.svg"
        }
      ]
    },
    "views": {
      "swiftPrismContainer": [
        {
          "id": "swiftPrismExplorer",
          "name": "SwiftPrism Explorer",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "swiftPrism.analyzeProject",
        "title": "SwiftPrism: Analyze Project",
        "icon": "$(play)"
      },
      {
        "command": "swiftPrism.refresh",
        "title": "SwiftPrism: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "swiftPrism.showRawJson",
        "title": "SwiftPrism: View Raw JSON",
        "icon": "$(json)"
      },
      {
        "command": "swiftPrism.analyzeAndShowJson",
        "title": "SwiftPrism: Analyze & View JSON"
      },
      {
        "command": "swiftPrism.clearCache",
        "title": "SwiftPrism: Clear Cache"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "swiftPrism.analyzeProject",
          "when": "view == swiftPrismExplorer",
          "group": "navigation@1"
        },
        {
          "command": "swiftPrism.refresh",
          "when": "view == swiftPrismExplorer",
          "group": "navigation@2"
        },
        {
          "command": "swiftPrism.showRawJson",
          "when": "view == swiftPrismExplorer",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ && cp -r src/webview out/webview 2>/dev/null || true",
    "compile:webview": "cd webview && npm run build",
    "build": "npm run compile && npm run compile:webview",
    "watch": "tsc -watch -p ./",
    "install:all": "npm install && cd webview && npm install"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
