.docker/

# ── Swift / SPM ──────────────────────────────────────────────────
core/.build/
core/.swiftpm/
core/*.xcodeproj/
core/*.xcworkspace/
!core/*.xcworkspace/xcshareddata/
core/DerivedData/
core/Packages/
core/.index-build/

# ── Node / Extension Host ───────────────────────────────────────
extension/node_modules/
extension/out/
extension/dist-webview/
extension/bin/
