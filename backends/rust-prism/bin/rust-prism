#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
export PRISM_EXTS="${PRISM_EXTS:-rs}"
export CODE_PRISM_LANG="${CODE_PRISM_LANG:-rust}"
EXTRACT="${PRISM_EXTRACT:-$HOME/bin/prism-extract}"
if [[ -x "$EXTRACT" ]]; then
  exec "$EXTRACT" --lang "rust" "$@"
fi
exec node "$DIR/src/build-sot.mjs" --lang rust "$@"
