#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
export PRISM_EXTS="${PRISM_EXTS:-js,jsx,ts,tsx,mjs,cjs}"
export CODE_PRISM_LANG="${CODE_PRISM_LANG:-js}"
EXTRACT="${PRISM_EXTRACT:-$HOME/bin/prism-extract}"
if [[ -x "$EXTRACT" ]]; then
  exec "$EXTRACT" --lang "js" "$@"
fi
exec node "$DIR/index.mjs" --lang js "$@"
