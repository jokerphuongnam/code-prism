#!/usr/bin/env bash
# Shim: prefer a built analyzer next to this repo, then legacy, then App Support.
set -uo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"
legacy=""
if legacy="$(cd "$root/.legacy-backends/swift-prism" 2>/dev/null && pwd)"; then
  :
else
  legacy=""
fi
CANDIDATES=(
  "$HOME/Library/Application Support/CodePrism/backends/swift/swift-prism-analyzer"
  "$root/backends/swift-prism/core/.build/release/swift-prism-analyzer"
  "$root/backends/swift-prism/core/.build/arm64-apple-macosx/release/swift-prism-analyzer"
  "${legacy:+$legacy/core/.build/release/swift-prism-analyzer}"
  "${legacy:+$legacy/extension/bin/swift-prism-analyzer}"
)
for c in "${CANDIDATES[@]}"; do
  if [[ -n "$c" && -x "$c" ]]; then
    exec "$c" "$@"
  fi
done
echo "error: swift-prism-analyzer not found. Build swift backend (see backends/swift/README.md)" >&2
exit 127
