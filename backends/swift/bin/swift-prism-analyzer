#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
BUILT="$DIR/core/.build/release/swift-prism-analyzer"
VENDOR="$DIR/bin/swift-prism-analyzer.bin"
if [[ -x "$BUILT" ]]; then exec "$BUILT" "$@"; fi
if [[ -x "$VENDOR" ]]; then exec "$VENDOR" "$@"; fi
echo "swift-prism: build backends/swift/core with: swift build -c release" >&2
exit 1
