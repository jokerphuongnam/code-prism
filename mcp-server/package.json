{
  "name": "swiftprism-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server exposing SwiftPrism dependency graph to AI agents",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "swift-prism-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "watch": "tsc --watch & nodemon --watch dist --exec 'node dist/server.js'",
    "subgraph": "node dist/subgraph-agent.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
