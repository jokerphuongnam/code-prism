{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SwiftPrism Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/out/**/*.js"
      ],
      "preLaunchTask": "SwiftPrism: Watch Extension",
      "env": {
        "VSCODE_DEBUG_MODE": "true"
      }
    },
    {
      "name": "Run SwiftPrism (Full Build)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/out/**/*.js"
      ],
      "preLaunchTask": "SwiftPrism: Build Extension Only"
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder}/core",
      "name": "Debug SwiftPrismAnalyzer",
      "target": "SwiftPrismAnalyzer",
      "configuration": "debug",
      "preLaunchTask": "SwiftPrism: Build Swift Core Only"
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder:swift-prism}/core",
      "name": "Debug swift-prism-analyzer (core)",
      "target": "swift-prism-analyzer",
      "configuration": "debug",
      "preLaunchTask": "swift: Build Debug swift-prism-analyzer (core)"
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder:swift-prism}/core",
      "name": "Release swift-prism-analyzer (core)",
      "target": "swift-prism-analyzer",
      "configuration": "release",
      "preLaunchTask": "swift: Build Release swift-prism-analyzer (core)"
    }
  ]
}
